# ───────────────────────── Secrets & keys: NEVER commit ─────────────────────────
# Environment files (the template .env.example is the only one tracked)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
# Operator + agent signing material (the autonomous agent's own testnet key lives here)
data/operator.token
data/agent*
data/*.key
data/*.keys.json
.agent-keys/
agent.keys.json
agent*.keys.json
# Generic key / credential formats
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
*.mnemonic
*.seed
secrets/
.secrets/
credentials.json
service-account*.json
# NEAR + Foundry + Cloudflare local credentials
.near-credentials/
neardev/
.foundry/keystores/
keystores/
.wrangler/
.cloudflared/
.vercel/
.netlify/
.turso/
cast-keystore/

# ───────────────────────── Runtime data (local state, never source) ─────────────────────────
data/*.db
data/*.db-*
data/*.sqlite
data/*.sqlite-*
data/artifacts/
data/*.log
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db-shm
*.db-wal
# near-sandbox / anvil local chain state
.near-sandbox/
near-sandbox-*/
sandbox-data/
anvil-state*.json
anvil*.log

# ───────────────────────── Dependencies ─────────────────────────
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz
.npm/
jspm_packages/
bower_components/

# ───────────────────────── Build outputs ─────────────────────────
# NOTE: web/dist is TRACKED in this repo today (committed by an earlier session, probably so Workers assets deploy
# without a build step). It is deliberately NOT ignored here; untracking it is a separate decision.
build/
.vite/
.cache/
.parcel-cache/
.turbo/
.next/
.output/
*.tsbuildinfo
# Rust: every crate, including contracts/near-vault/integration (≈1 GB each)
target/
# Foundry (contracts/evm/.gitignore also covers these)
contracts/evm/out/
contracts/evm/cache/
contracts/evm/broadcast/
contracts/evm/dist/*
!contracts/evm/dist/AgentVault.json
!contracts/evm/dist/AgentVault.abi.json
!contracts/evm/dist/ProposalRegistry.json
# Reproducible NEAR wasm builds ARE tracked (hashes are documented and tests read them);
# everything else generated beside them is not.
contracts/near-registry/dist/*
!contracts/near-registry/dist/autonear_registry.wasm
contracts/near-vault/dist/*
!contracts/near-vault/dist/autonear_vault.wasm
# Generated by scripts, not hand-edited
*.wasm.map

# ───────────────────────── Test, coverage, perf & audit scratch ─────────────────────────
coverage/
.nyc_output/
lcov.info
*.lcov
*.profraw
*.profdata
cobertura.xml
tarpaulin-report.html
test-results/
playwright-report/
playwright/.cache/
blob-report/
.lighthouseci/
lighthouse-*.json
lighthouse-*.html
*.lhr.json
*.cpuprofile
*.heapsnapshot
*.trace
slither-report*.json
slither-report*.sarif
crytic-export/
echidna-corpus/
medusa-corpus/
fuzz-artifacts/
proptest-regressions/
# Codex / LLM review raw logs are kept only when curated into docs/audit/
codex-*.raw.tmp
*.codex.tmp

# ───────────────────────── Logs, temp, OS, editors ─────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.pid.lock
*.seed.lock
tmp/
temp/
.tmp/
scratch/
*.bak
*.orig
*.rej
*.swp
*.swo
*~
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.iml
.history/
# Local AI-assistant state (settings stay on the developer's machine)
.claude/settings.local.json
.claude/projects/
.claude/scratch/
.cursor/
.aider*
.continue/
.codex/
CLAUDE.local.md
*.local.md

# Lockfiles ARE tracked (reproducible builds, `cargo --locked`, forge). A global *.lock rule on a dev machine must not hide them.
!*.lock
!Cargo.lock
!**/Cargo.lock
!foundry.lock

# local copies of deployed secrets
data/*.token
data/*.secret

# animation proof frames (large); keep only the headline screenshots in git
docs/screenshots/constellation-frame-*.png
