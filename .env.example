# AutoNEAR configuration. Copy to .env locally; on Vercel set these in Project Settings -> Environment Variables.
# Never commit real values.

# ---- Server / storage ------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# Local dev uses a SQLite file. On Vercel set DATABASE_URL (libSQL/Turso) because the FS is ephemeral.
DB_PATH=data/autonear.db
DATABASE_URL=                      # e.g. libsql://autonear-<org>.turso.io   (REQUIRED on Vercel)
DATABASE_AUTH_TOKEN=               # Turso auth token                        (REQUIRED on Vercel)

# ---- Auth ------------------------------------------------------------------
# Bearer token for every mutation. Locally auto-generated into data/operator.token if empty.
# On Vercel it MUST be set, otherwise all mutations are refused.
OPERATOR_TOKEN=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/*.
CRON_SECRET=

# ---- Ingestion -------------------------------------------------------------
INGEST_INTERVAL_MS=900000          # local scheduler cadence (15 min). Vercel uses vercel.json crons instead.
GITHUB_TOKEN=                      # optional, read-only public scope; raises GitHub rate limits

# ---- LLM (placeholders: add credentials later; empty = deterministic baseline) ----
# none | anthropic | gateway | codex-cli (local dev only)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Vercel AI Gateway (OpenAI-compatible). Model slug is a placeholder - confirm in your Gateway dashboard.
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1/chat/completions
AI_GATEWAY_MODEL=anthropic/claude-sonnet-5-5
# Spend ceilings enforced by the policy engine (outside the LLM)
RUN_BUDGET_USD=0.50
RUN_BUDGET_TOKENS=60000

# ---- NEAR ------------------------------------------------------------------
NEAR_NETWORK=testnet
NEAR_TESTNET_RPC=https://rpc.testnet.near.org
NEAR_MAINNET_RPC=https://rpc.mainnet.near.org
# PUBLIC account id the human deploys with. Private keys never belong in env/config.
NEAR_DEPLOY_ACCOUNT=

# ---- Optional engine adapters (all default off; see /engines) --------------
PYTHIA_ENABLED=false
MIROFISH_URL=
KRONOS_ENABLED=false

# ---- Rate limiting ----------------------------------------------------------
# Set to 1 ONLY when a reverse proxy you control sets X-Forwarded-For / CF-Connecting-IP. Unset, the socket address is used.
TRUST_PROXY=

# ---- Mandate Vault / agent wallet (TESTNET ONLY; mainnet is blocked in code) ----
# Where the agent's testnet keys live (mode 0600, created by `npm run agent:init`). Empty = data/agent.keys.json (gitignored).
AGENT_KEYS_PATH=
# Env keys WIN over the file. Leave EMPTY unless you know why; never commit or paste a real value anywhere. EVM: 0x + 64 hex. NEAR: ed25519:<base58>.
AGENT_EVM_PRIVATE_KEY=
AGENT_NEAR_PRIVATE_KEY=
# Autonomy kill switch: the agent acts ONLY when this is exactly 1 (or true). Default OFF.
AUTONOMY_ENABLED=0
# Max agent executions per rolling 24h (hard-capped at 50 in code; a mandate's own loop.maxPerDay can only lower it).
AUTONOMY_MAX_PER_DAY=5
# Cadence of the in-process autonomy loop (min 10000). It also runs after every pipeline tick.
AUTONOMY_INTERVAL_MS=60000
# Ceiling on a grant_mandate's total cap, in WHOLE units of the chain's native token ("0.25", or "evm:0.25,near:10").
# Defaults 0.5 ETH-testnet / 20 NEAR; values above the compiled-in maximum (1 ETH / 50 NEAR) are clamped.
VAULT_MAX_TOTAL_CAP=
# Public base URL of this deployment. When set, GET /.well-known/agent-registration.json serves a DRAFT ERC-8004 registration file
# (nothing is registered on-chain by the server). Empty = that endpoint is 404.
AGENT_PUBLIC_URL=
