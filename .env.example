# AutoNEAR configuration. Copy to .env locally; on Vercel set these in Project Settings -> Environment Variables.
# Never commit real values.

# ---- Server / storage ------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# Local dev uses a SQLite file. On Vercel set DATABASE_URL (libSQL/Turso) because the FS is ephemeral.
DB_PATH=data/autonear.db
DATABASE_URL=                      # e.g. libsql://autonear-<org>.turso.io   (REQUIRED on Vercel)
DATABASE_AUTH_TOKEN=               # Turso auth token                        (REQUIRED on Vercel)

# ---- Auth ------------------------------------------------------------------
# Bearer token for every mutation. Locally auto-generated into data/operator.token if empty.
# On Vercel it MUST be set, otherwise all mutations are refused.
OPERATOR_TOKEN=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/*.
CRON_SECRET=

# ---- Ingestion -------------------------------------------------------------
INGEST_INTERVAL_MS=900000          # local scheduler cadence (15 min). Vercel uses vercel.json crons instead.
GITHUB_TOKEN=                      # optional, read-only public scope; raises GitHub rate limits

# ---- LLM (placeholders: add credentials later; empty = deterministic baseline) ----
# none | anthropic | gateway | codex-cli (local dev only)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Vercel AI Gateway (OpenAI-compatible). Model slug is a placeholder - confirm in your Gateway dashboard.
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1/chat/completions
AI_GATEWAY_MODEL=anthropic/claude-sonnet-5-5
# Spend ceilings enforced by the policy engine (outside the LLM)
RUN_BUDGET_USD=0.50
RUN_BUDGET_TOKENS=60000

# ---- NEAR ------------------------------------------------------------------
NEAR_NETWORK=testnet
NEAR_TESTNET_RPC=https://rpc.testnet.near.org
NEAR_MAINNET_RPC=https://rpc.mainnet.near.org
# PUBLIC account id the human deploys with. Private keys never belong in env/config.
NEAR_DEPLOY_ACCOUNT=

# ---- Optional engine adapters (all default off; see /engines) --------------
PYTHIA_ENABLED=false
MIROFISH_URL=
KRONOS_ENABLED=false
