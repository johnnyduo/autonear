# AutoNEAR configuration. Copy to .env locally; on Vercel set these in Project Settings -> Environment Variables.
# Never commit real values.

# ---- Server / storage ------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# Local dev uses a SQLite file. On Vercel set DATABASE_URL (libSQL/Turso) because the FS is ephemeral.
DB_PATH=data/autonear.db
DATABASE_URL=                      # e.g. libsql://autonear-<org>.turso.io   (REQUIRED on Vercel)
DATABASE_AUTH_TOKEN=               # Turso auth token                        (REQUIRED on Vercel)

# ---- Auth ------------------------------------------------------------------
# Bearer token for every mutation. Locally auto-generated into data/operator.token if empty.
# On Vercel it MUST be set, otherwise all mutations are refused.
OPERATOR_TOKEN=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/*.
CRON_SECRET=

# ---- Ingestion -------------------------------------------------------------
INGEST_INTERVAL_MS=900000          # local scheduler cadence (15 min). Vercel uses vercel.json crons instead.
GITHUB_TOKEN=                      # optional, read-only public scope; raises GitHub rate limits

# ---- Social / news evidence (FREE sources; every value is optional, defaults work) --------------------------------
# Sources: NEAR Social (on-chain social.near), Mastodon public hashtag timelines, Farcaster (community hub), Dev.to, Bluesky (opt-in).
# X/Twitter (no free API tier, scraping violates ToS) and Reddit (not self-serve free) are intentionally NOT implemented.
# Social records are low-weight demand evidence (0.4x) and never count toward the 3-independent-source rule; see /api/scoring.
# LLM_INCLUDE_SOCIAL=1 lets social post text (inside an untrusted fence) into analyst/skeptic prompts. Default OFF: social text is untrusted. See SECURITY.md.
LLM_INCLUDE_SOCIAL=
SOCIAL_MAX_ITEMS=40                # per-source cap of relevant items processed per tick (1..200); bounds DB queries per tick
SOCIAL_MAX_AGE_DAYS=90             # older posts are dropped before storage (counted as outOfWindow in /api/status meta)
SOCIAL_BUDGET_MS=25000             # wall-clock budget per social connector per tick; it stops early and reports partial
NEAR_SOCIAL_MAX_ITEMS=             # optional per-source overrides of SOCIAL_MAX_ITEMS
MASTODON_MAX_ITEMS=
FARCASTER_MAX_ITEMS=
DEVTO_MAX_ITEMS=
BLUESKY_MAX_ITEMS=
MASTODON_INSTANCES=mastodon.social,mastodon.online   # only hosts on the outbound allowlist (src/http-client.js) can be reached
MASTODON_TAGS=nearprotocol,nearintents,near          # "near" is mostly the English word: the strict relevance filter rejects those posts
MASTODON_MAX_PAGES=2               # Link-header pages followed per tag/instance (1..3), only while a page is entirely inside the age window
DEVTO_TAGS=nearprotocol,near
FARCASTER_CHANNELS=near            # Farcaster hubs have NO keyword search: channels + a watchlist. The /near channel had no cast after 2026-02-24 on 2026-11-05
FARCASTER_FIDS=                    # comma-separated FIDs of accounts YOU choose to watch (curated prior; default empty, none verified as active official NEAR accounts)
FARCASTER_HUB_URL=                 # default https://haatz.quilibrium.com (community hub, no SLA); a host outside the allowlist fails closed
# Bluesky is OPT-IN: both must be set or the source stays `not_configured` and makes no request. Use an APP PASSWORD
# (Bluesky Settings > Privacy and security > App passwords), never your main password. Accounts hosted on bsky.social only. Untested live.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# ---- LLM (placeholders: add credentials later; empty = deterministic baseline) ----
# none | anthropic | gateway | codex-cli (local dev only)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Vercel AI Gateway (OpenAI-compatible). Model slug is a placeholder - confirm in your Gateway dashboard.
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1/chat/completions
AI_GATEWAY_MODEL=anthropic/claude-sonnet-5-5
# Spend ceilings enforced by the policy engine (outside the LLM)
RUN_BUDGET_USD=0.50
RUN_BUDGET_TOKENS=60000

# ---- NEAR ------------------------------------------------------------------
NEAR_NETWORK=testnet
NEAR_TESTNET_RPC=https://rpc.testnet.near.org
NEAR_MAINNET_RPC=https://rpc.mainnet.near.org
# PUBLIC account id the human deploys with. Private keys never belong in env/config.
NEAR_DEPLOY_ACCOUNT=

# ---- Optional engine adapters (all default off; see /engines) --------------
PYTHIA_ENABLED=false
MIROFISH_URL=
KRONOS_ENABLED=false

# ---- Rate limiting ----------------------------------------------------------
# Set to 1 ONLY when a reverse proxy you control sets X-Forwarded-For / CF-Connecting-IP. Unset, the socket address is used.
TRUST_PROXY=

# ---- Mandate Vault / agent wallet (TESTNET ONLY; mainnet is blocked in code) ----
# Where the agent's testnet keys live (mode 0600, created by `npm run agent:init`). Empty = data/agent.keys.json (gitignored).
AGENT_KEYS_PATH=
# Env keys WIN over the file. Leave EMPTY unless you know why; never commit or paste a real value anywhere. EVM: 0x + 64 hex. NEAR: ed25519:<base58>.
AGENT_EVM_PRIVATE_KEY=
AGENT_NEAR_PRIVATE_KEY=
# Autonomy kill switch: the agent acts ONLY when this is exactly 1 (or true). Default OFF.
AUTONOMY_ENABLED=0
# Max agent executions per rolling 24h (hard-capped at 50 in code; a mandate's own loop.maxPerDay can only lower it).
AUTONOMY_MAX_PER_DAY=5
# Cadence of the in-process autonomy loop (min 10000). It also runs after every pipeline tick.
AUTONOMY_INTERVAL_MS=60000
# Ceiling on a grant_mandate's total cap, in WHOLE units of the chain's native token ("0.25", or "evm:0.25,near:10").
# Defaults 0.5 ETH-testnet / 20 NEAR; values above the compiled-in maximum (1 ETH / 50 NEAR) are clamped.
VAULT_MAX_TOTAL_CAP=
# Public base URL of this deployment. When set, GET /.well-known/agent-registration.json serves a DRAFT ERC-8004 registration file
# (nothing is registered on-chain by the server). Empty = that endpoint is 404.
AGENT_PUBLIC_URL=

# --- Owner app (2026-11-06) ---
# The EVM address allowed to sign in as the vault owner (wallet-signed, free, no transaction). Empty = the one owner shared by all attached EVM vaults.
OWNER_ADDRESS=
# Extra owners (co-owners), comma-separated EVM addresses. They may sign in as owner exactly like OWNER_ADDRESS (change settings, approve requests bound to their own wallet);
# they never replace the primary owner and gain no on-chain power. Removing an address ends its sessions on the next request.
OWNER_ADDRESSES=
# Comma-separated domains (host[:port]) the sign-in message may be bound to. Set this in production; empty = trust the request Host header.
PUBLIC_HOSTS=
# Gas top-up band for the autonomy loop (Auto mode only), base units. Defaults: EVM 0.003 / 0.01 native, NEAR 0.5 / 2.
AUTONOMY_TOPUP_LOW=
AUTONOMY_TOPUP_TARGET=
