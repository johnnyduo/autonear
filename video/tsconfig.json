{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true, "allowJs": true, "checkJs": false,
    "resolveJsonModule": true, "esModuleInterop": true, "isolatedModules": true, "lib": ["ES2022", "DOM"]
  },
  "include": ["src", "script"]
}
