     "op": "draw",
     "args": {
      "amount": 250
     },
     "expect": "ok",
     "state": {
      "period_spent": 250,
      "total_spent": 750
     }
    },
    {
     "t": 2800,
     "as": "agent",
     "op": "draw",
     "args": {
      "amount": 250
     },
     "expect": "ok",
     "state": {
      "total_spent": 1000,
      "available": 4000
     }
    },
    {
     "t": 3400,
     "as": "agent",
     "op": "draw",
     "args": {
      "amount": 1
     },
     "expect": {
      "err": "TotalCap"
