{
 "version": 1,
 "note": "Shared by EVM tests, NEAR tests and src/vault-model.js. See the Mandate Vault spec. Do not edit to make an implementation pass.",
 "roles": [
  "owner",
  "agent",
  "other",
  "newOwner"
 ],
 "errors": [
  "Unauthorized",
  "Paused",
  "NoMandate",
  "MandateInactive",
  "BadMandate",
  "BadAmount",
  "PerDrawCap",
  "PeriodCap",
  "TotalCap",
  "InsufficientBalance",
  "DeployLimit",
  "TemplateNotAllowed",
  "CodeMismatch",
  "AddressTaken",
  "BadName",
  "BadTemplate",
  "BadOwner"
 ],
 "scenarios": [
  {
   "name": "draw_budget_rolling_periods",
   "description": "per-draw, per-period and total caps; period rolls over at start+k*period_secs",
   "setup": {
    "balance": 1000,
    "templates": [
     "t1",
     "t2"
    ]
   },
   "steps": [
    {
     "t": 1000,
     "as": "owner",
     "op": "set_mandate",
     "args": {
      "agent": "agent",
      "expires_at": 5000,
      "per_draw_cap": 100,
      "period_secs": 600,
      "period_cap": 250,
      "total_cap": 400,
      "max_deploys": 2
     },
     "expect": "ok",
     "state": {
      "epoch": 1,
      "available": 1000
     }
    },
    {
     "t": 1001,
     "as": "agent",
     "op": "preview_draw",
     "args": {
      "amount": 100
     },
     "expect": "ok"
    },
    {
     "t": 1001,
     "as": "agent",
     "op": "draw",
     "args": {
      "amount": 100
     },
     "expect": "ok",
     "state": {
      "available": 900,
      "total_spent": 100,
      "period_spent": 100,
      "received": {
       "agent": 100
      }
     }
    },
    {
     "t": 1002,
     "as": "agent",
     "op": "draw",
     "args": {
      "amount": 100
     },
     "expect": "ok",
     "state": {
      "available": 800,
      "total_spent": 200,
      "period_spent": 200
     }
    },
    {
     "t": 1003,
     "as": "agent",
     "op": "preview_draw",
     "args": {
      "amount": 51
     },
     "expect": {
      "err": "PeriodCap"
     }
    },
    {
     "t": 1003,
     "as": "agent",
     "op": "draw",
     "args": {
      "amount": 51
     },
     "expect": {
      "err": "PeriodCap"
     },
     "state": {
      "total_spent": 200
     }
    },
    {
     "t": 1004,
     "as": "agent",
     "op": "draw",
     "args": {
      "amount": 50
     },
     "expect": "ok",
     "state": {
      "available": 750,
      "total_spent": 250,
      "period_spent": 250
     }
    },
    {
     "t": 1005,
     "as": "agent",
     "op": "draw",
     "args": {
      "amount": 1
     },
     "expect": {
      "err": "PeriodCap"
     }
    },
    {
     "t": 1600,
     "as": "agent",
     "op": "draw",
     "args": {
      "amount": 100
     },
     "expect": "ok",
     "state": {
      "available": 650,
      "total_spent": 350,
      "period_spent": 100
     }
    },
    {
     "t": 1601,
     "as": "agent",
     "op": "draw",
     "args": {
      "amount": 100
     },
     "expect": {
      "err": "TotalCap"
     }
    },
    {
     "t": 1602,
     "as": "agent",
     "op": "draw",
     "args": {
      "amount": 50
     },
     "expect": "ok",
     "state": {
      "available": 600,
      "total_spent": 400,
      "period_spent": 150,
      "received": {
       "agent": 400
      }
     }
    },
    {
     "t": 1603,
     "as": "agent",
     "op": "draw",
     "args": {
      "amount": 1
     },
     "expect": {
      "err": "TotalCap"
     }
    }
   ]
  },
