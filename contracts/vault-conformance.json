     "state": {
      "available": 50,
      "total_spent": 0
     }
    },
    {
     "t": 12,
     "as": "other",
     "op": "deposit",
     "args": {
      "amount": 100
     },
     "expect": "ok",
     "state": {
      "available": 150
     }
    },
    {
     "t": 13,
     "as": "agent",
     "op": "draw",
     "args": {
      "amount": 60
     },
     "expect": "ok",
     "state": {
      "available": 90,
      "received": {
       "agent": 60
      }
     }
    }
   ]
